# Dashboard service

# Core services
# Railway Postgres URL for the shared app database.
DATABASE_URL=""
# Railway Redis URL used by dashboard caches and quota snapshots.
REDIS_URL=""

# Auth/app URLs
# Public URL of the deployed dashboard service.
BETTER_AUTH_URL=""
# Shared secret used for Better Auth and encrypted provider data.
BETTER_AUTH_SECRET=""
# Public URL of the proxy service (Koyeb), used by Playground and server-side external provider validation relay.
NUXT_PUBLIC_PROXY_URL=""
# Optional JSON array of dashboard user emails that should show the maintainer role indicator.
MAINTAINERS=[]

# GitHub OAuth
# Callback URL: https://xxxx/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
# Callback URL: https://xxxx/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local OAuth emulation
# Start the emulators with: pnpm --filter @opendum/dashboard emulate
# Then run the dashboard with AUTH_OAUTH_EMULATOR=1 (pnpm dev:emulate) to sign in
# through the local GitHub/Google emulators instead of real OAuth apps.
AUTH_OAUTH_EMULATOR="0"
GITHUB_EMULATOR_URL="http://localhost:4001"
GOOGLE_EMULATOR_URL="http://localhost:4002"
