# Opendum API (Hono + Node)
PORT=3001
DATABASE_URL=postgres://user:pass@localhost:5432/opendum
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=["http://localhost:5173"]
PROXY_URL=http://localhost:4001
# Optional GitHub/Google OAuth (required for production sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON array of maintener emails
MAINTENERS=["you@example.com"]
