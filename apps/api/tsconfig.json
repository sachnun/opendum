{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "node",
      "bun"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "proxy/**/*",
    "handlers/**/*",
    "plugins/**/*",
    "routes/**/*",
    "test/**/*",
    "web/**/*",
    "*.ts",
    "nitro.config.ts"
  ]
}
