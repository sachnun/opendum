# Opendum Web (Vite + React)
# Base URL of the API used by the Vite dev proxy
VITE_API_URL=http://localhost:3001
# Base URL of the proxy used by the Vite dev proxy
VITE_PROXY_URL=http://localhost:4001
# Shown on the API Keys page (production: the deployed proxy origin)
VITE_PUBLIC_PROXY_URL=https://proxy.example.com
