{
  "name": "@opendum/web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "predev": "pnpm family-ranking",
    "prebuild": "pnpm family-ranking",
    "pretest": "pnpm family-ranking",
    "pretest:unit": "pnpm family-ranking",
    "family-ranking": "tsx ./scripts/family-ranking.ts",
    "test": "tsx --test ./lib/*.test.ts && vitest run",
    "test:unit": "tsx --test ./lib/*.test.ts",
    "test:nuxt": "vitest run",
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.43.0",
    "@nuxt/fonts": "^0.14.0",
    "@opendum/auth": "workspace:*",
    "@opendum/database": "workspace:*",
    "@opendum/models": "workspace:*",
    "@opendum/providers": "workspace:*",
    "@opendum/redis": "workspace:*",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^3.1.0",
    "h3": "^1.15.0",
    "idb-keyval": "^6.3.0",
    "nuxt": "^4.5.2",
    "redis": "^6.1.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.7"
  }
