# Opendum Proxy (Hono + Node, ported from Go)
HOST=0.0.0.0
PORT=4001
DATABASE_URL=postgres://user:pass@localhost:5432/opendum
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me
# Seconds between token refresher scans (0 disables)
TOKEN_REFRESH_INTERVAL_SECONDS=600
# Path to the models registry directory (auto-detected from repo root)
MODELS_DIR=
