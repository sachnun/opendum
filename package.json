{
  "name": "opendum",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev:dashboard": "pnpm --filter @opendum/dashboard dev",
    "dev:proxy": "pnpm --filter @opendum/proxy dev",
    "dev": "(pnpm dev:dashboard & pnpm dev:proxy)",
    "build:dashboard": "pnpm --filter @opendum/dashboard build",
    "build:proxy": "pnpm --filter @opendum/proxy build",
    "build": "pnpm build:dashboard && pnpm build:proxy",
    "db:push": "pnpm --filter @opendum/database db:push",
    "db:studio": "pnpm --filter @opendum/database db:studio",
    "lint": "pnpm --filter @opendum/dashboard lint && pnpm --filter @opendum/proxy typecheck",
    "models:refresh": "node scripts/models.mjs"
  },
  "devDependencies": {
    "edgeone": "^1.6.34",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28",
      "typescript-eslint": "^8.62.1",
      "@typescript-eslint/eslint-plugin": "^8.62.1",
      "@typescript-eslint/parser": "^8.62.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
