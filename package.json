{
  "name": "opendum",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:dashboard": "pnpm --filter @opendum/dashboard dev",
    "dev:proxy": "TOKEN_REFRESH_INTERVAL_SECONDS=0 go -C apps/proxy run ./cmd/proxy",
    "dev": "(pnpm run dev:dashboard & pnpm run dev:proxy)",
    "build:dashboard": "pnpm --filter @opendum/dashboard build",
    "build:proxy": "go -C apps/proxy build ./...",
    "build": "pnpm run build:dashboard && pnpm run build:proxy",
    "db:push": "pnpm --filter @opendum/dashboard db:push",
    "db:studio": "pnpm --filter @opendum/dashboard db:studio",
    "lint": "pnpm --filter @opendum/dashboard lint && pnpm --filter @opendum/models typecheck && go -C apps/proxy test ./...",
    "models:refresh": "pnpm --filter @opendum/models refresh",
    "models:metadata": "pnpm --filter @opendum/models refresh:metadata",
    "models:test": "pnpm --filter @opendum/models test"
  },
  "devDependencies": {
    "edgeone": "^1.6.34",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
