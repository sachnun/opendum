{
  "name": "opendum",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.14.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace @opendum/dashboard",
    "dev:proxy": "TOKEN_REFRESH_INTERVAL_SECONDS=0 go -C apps/proxy run ./cmd/proxy",
    "dev": "(npm run dev:dashboard & npm run dev:proxy)",
    "build:dashboard": "npm run build --workspace @opendum/dashboard",
    "build:proxy": "go -C apps/proxy build ./...",
    "build": "npm run build:dashboard && npm run build:proxy",
    "db:push": "npm run db:push --workspace @opendum/dashboard",
    "db:studio": "npm run db:studio --workspace @opendum/dashboard",
    "lint": "npm run lint --workspace @opendum/dashboard && go -C apps/proxy test ./... && go -C packages/ai test ./...",
    "models:refresh": "go run ./packages/ai/cmd/opendum refresh"
  },
  "devDependencies": {
    "edgeone": "^1.6.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "typescript-eslint": "^8.62.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.6": true,
    "vue-demi@0.14.10": true
  }
}
