{
  "name": "opendum",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "(bun run --filter @opendum/web dev & bun run --filter @opendum/api dev)",
    "build": "bun run --filter @opendum/web build && bun run --filter @opendum/api typecheck",
    "lint": "oxlint .",
    "db:push": "bun run --filter @opendum/database db:push",
    "db:generate": "bun run --filter @opendum/database db:generate",
    "db:migrate": "bun run --filter @opendum/database db:migrate",
    "models:refresh": "bun run --filter @opendum/models refresh && bun run --filter @opendum/models family-ranking"
  },
  "devDependencies": {
    "@kevinmichaelchen/oxlint-plugin-naming-convention": "^0.1.1",
    "eslint-plugin-no-comments": "^1.2.1",
    "oxlint": "^1.89.0",
    "oxlint-plugin-effect": "0.29.0",
    "oxlint-tsgolint": "^7.0.2005",
    "wrangler": "^4.152.0"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "vue-demi",
    "workerd"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.28"
  }
}
