{
  "name": "opendum",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@12.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:proxy dev:web",
    "dev:web": "npm run dev --workspace @opendum/web",
    "dev:api": "npm run dev --workspace @opendum/api",
    "dev:proxy": "npm run dev --workspace @opendum/proxy",
    "build": "npm run build --workspace @opendum/web && npm run build --workspace @opendum/api && npm run build --workspace @opendum/proxy",
    "build:web": "npm run build --workspace @opendum/web",
    "build:api": "npm run build --workspace @opendum/api",
    "build:proxy": "npm run build --workspace @opendum/proxy",
    "test": "npm run test --workspace @opendum/api && npm run test --workspace @opendum/proxy",
    "test:proxy": "npm run test --workspace @opendum/proxy",
    "test:api": "npm run test --workspace @opendum/api",
    "lint": "npm run lint --workspace @opendum/web && npm run lint --workspace @opendum/api && npm run lint --workspace @opendum/proxy",
    "db:push": "npm run db:push --workspace @opendum/shared",
    "db:studio": "npm run db:studio --workspace @opendum/shared",
    "models:refresh": "node scripts/models.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "typescript-eslint": "^8.62.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.6": true,
    "vue-demi@0.14.10": true
  }
}
