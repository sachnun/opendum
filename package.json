{
  "name": "opendum",
  "private": true,
  "scripts": {
    "dev": "(bun run --filter @opendum/web dev & bun run --filter @opendum/proxy dev)",
    "build": "bun run --filter @opendum/web build && bun run --filter @opendum/proxy check",
    "lint": "oxlint .",
    "db:push": "bun run --filter @opendum/database db:push",
    "db:generate": "bun run --filter @opendum/database db:generate",
    "db:migrate": "bun run --filter @opendum/database db:migrate",
    "models:refresh": "bun run --filter @opendum/models refresh && bun run --filter @opendum/web family-ranking"
  },
  "devDependencies": {
    "edgeone": "^1.6.41",
    "oxlint": "^1.88.0"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "vue-demi"
  ],
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.28"
  }
}
