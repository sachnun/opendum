{
  "name": "opendum",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "(pnpm --filter @opendum/web dev & pnpm --filter @opendum/proxy dev)",
    "build": "pnpm --filter @opendum/web build && pnpm --filter @opendum/proxy typecheck",
    "db:push": "pnpm --filter @opendum/database db:push",
    "db:generate": "pnpm --filter @opendum/database db:generate",
    "db:migrate": "pnpm --filter @opendum/database db:migrate",
    "models:refresh": "pnpm --filter @opendum/models refresh && pnpm --filter @opendum/web family-ranking",
    "lint": "eslint packages services",
    "lint:fix": "eslint packages services --fix"
  },
  "devDependencies": {
    "edgeone": "^1.6.34",
    "@eslint/js": "^10.0.0",
    "eslint": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "typescript-eslint": "^8.62.1"
  }
}
