{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "unicorn",
    "oxc",
    "vue"
  ],
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": [
    "eslint-plugin-no-comments",
    "@kevinmichaelchen/oxlint-plugin-naming-convention",
    "oxlint-plugin-effect/plugin"
  ],
  "rules": {
    "no-comments/disallowComments": [
      "error",
      {
        "allow": [
          "eslint",
          "global"
        ]
      }
    ],
    "class-methods-use-this": [
      "error",
      {
        "enforceForClassFields": true,
        "ignoreClassesWithImplements": "all",
        "exceptMethods": [
          "toParsed",
          "toPayload"
        ]
      }
    ],
    "max-classes-per-file": [
      "error",
      8
    ],
    "no-useless-constructor": "error",
    "no-dupe-class-members": "error",
    "no-unused-private-class-members": "error",
    "typescript/class-literal-property-style": [
      "error",
      "fields"
    ],
    "id-length": [
      "error",
      {
        "min": 1,
        "max": 40,
        "exceptions": [
          "_",
          "__",
          "id",
          "x",
          "y"
        ]
      }
    ],
    "naming-convention/naming-convention": [
      "error",
      {
        "selector": "variable",
        "filter": {
          "match": true,
          "regex": "^[A-Z][A-Z0-9_]*$"
        },
        "format": [
          "UPPER_CASE"
        ],
        "leadingUnderscore": "allowSingleOrDouble",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
        }
      },
      {
        "selector": "variable",
        "format": [
          "camelCase",
          "UPPER_CASE",
          "PascalCase"
        ],
        "leadingUnderscore": "allowSingleOrDouble",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
        }
      },
      {
        "selector": "function",
        "format": [
          "camelCase"
        ],
        "leadingUnderscore": "allow",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,2}$|^[_$]*$"
        }
      },
      {
        "selector": [
          "parameter",
          "parameterProperty"
        ],
        "format": [
          "camelCase"
        ],
        "leadingUnderscore": "allowSingleOrDouble",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
        }
      },
      {
        "selector": [
          "typeLike",
          "enumMember"
        ],
        "format": [
          "PascalCase"
        ],
        "leadingUnderscore": "allow",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
        }
      },
      {
        "selector": [
          "classProperty",
          "classMethod",
          "classicAccessor",
          "autoAccessor"
        ],
        "format": [
          "camelCase",
          "UPPER_CASE"
        ],
        "leadingUnderscore": "allow",
        "trailingUnderscore": "forbid",
        "custom": {
          "match": true,
          "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
        }
      }
    ],
    "import/extensions": [
      "error",
      "never",
      {
        "vue": "always"
      }
    ],
    "import/no-relative-parent-imports": "error",
    "effect/noNewPromise": "error",
    "effect/noTryCatch": "error",
    "effect/noThrowStatement": "error"
  },
  "ignorePatterns": [
    "**/.nuxt/**",
    "**/.output/**",
    "**/.edgeone/**",
    "**/dist/**",
    "**/coverage/**"
  ],
  "overrides": [
    {
      "files": [
        "**/composables/**"
      ],
      "rules": {
        "naming-convention/naming-convention": [
          "error",
          {
            "selector": "variable",
            "filter": {
              "match": true,
              "regex": "^[A-Z][A-Z0-9_]*$"
            },
            "format": [
              "UPPER_CASE"
            ],
            "leadingUnderscore": "allowSingleOrDouble",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          },
          {
            "selector": "variable",
            "format": [
              "camelCase",
              "UPPER_CASE",
              "PascalCase"
            ],
            "leadingUnderscore": "allowSingleOrDouble",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          },
          {
            "selector": "function",
            "format": [
              "camelCase"
            ],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          },
          {
            "selector": [
              "parameter",
              "parameterProperty"
            ],
            "format": [
              "camelCase"
            ],
            "leadingUnderscore": "allowSingleOrDouble",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          },
          {
            "selector": [
              "typeLike",
              "enumMember"
            ],
            "format": [
              "PascalCase"
            ],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          },
          {
            "selector": [
              "classProperty",
              "classMethod",
              "classicAccessor",
              "autoAccessor"
            ],
            "format": [
              "camelCase",
              "UPPER_CASE"
            ],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "forbid",
            "custom": {
              "match": true,
              "regex": "^[_$]*(?:[^_$](?:(?!(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z][A-Z])(?=[a-z]))[^_$])*[_$]*){1,3}$|^[_$]*$"
            }
          }
        ]
      }
    },
    {
      "files": [
        "packages/core/egress/guard.ts"
      ],
      "rules": {
        "import/extensions": "off"
      }
    }
  ]
}
