{
  "providers": [
    "kilo_code",
    "openrouter"
  ],
  "reasoning": true,
  "modalities": {
    "input": [
      "text"
    ],
    "output": [
      "text"
    ]
  },
  "limit": {
    "context": 256000,
    "output": 64000
  },
  "providerConfig": {
    "kilo_code": {
      "upstream": "cohere/north-mini-code:free",
      "contextWindow": 256000,
      "maxOutputTokens": 64000,
      "authless": true
    },
    "openrouter": {
      "upstream": "cohere/north-mini-code:free",
      "contextWindow": 256000,
      "maxOutputTokens": 64000
    }
  }
}
