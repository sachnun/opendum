{
  "providers": [
    "zenmux",
    "hyper",
    "perch"
  ],
  "reasoning": true,
  "modalities": {
    "input": [
      "image",
      "text",
      "video"
    ],
    "output": [
      "text"
    ]
  },
  "limit": {
    "context": 1048576,
    "output": 512000
  },
  "providerConfig": {
    "hyper": {
      "contextWindow": 512000,
      "maxOutputTokens": 512000
    },
    "perch": {
      "contextWindow": 512000,
      "maxOutputTokens": 80000
    },
    "zenmux": {
      "upstream": "minimax/minimax-m3",
      "contextWindow": 1048576,
      "maxOutputTokens": 512000
    }
  }
}
