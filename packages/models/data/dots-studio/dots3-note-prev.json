{
  "providers": [
    "zenmux"
  ],
  "reasoning": true,
  "modalities": {
    "input": [
      "image",
      "text"
    ],
    "output": [
      "text"
    ]
  },
  "limit": {
    "context": 512000,
    "output": 460800
  },
  "providerConfig": {
    "zenmux": {
      "upstream": "dots-studio/dots3-note-prev",
      "contextWindow": 512000,
      "maxOutputTokens": 460800
    }
  }
}
