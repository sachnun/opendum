{
  "providers": [
    "zenmux"
  ],
  "reasoning": true,
  "modalities": {
    "input": [
      "image",
      "text"
    ],
    "output": [
      "text"
    ]
  },
  "limit": {
    "context": 1000000,
    "output": 1000000
  },
  "providerConfig": {
    "zenmux": {
      "upstream": "sakana/fugu-ultra-v2",
      "contextWindow": 1000000,
      "maxOutputTokens": 1000000
    }
  }
}
