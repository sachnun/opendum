{
  "name": "@opendum/models",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./clean-key": "./src/clean-key.ts",
    "./families": "./src/families.ts",
    "./merge": "./src/merge.ts",
    "./probes": "./src/probes.ts",
    "./registry": "./src/registry.ts",
    "./runtime": "./src/runtime.ts"
  },
  "imports": {
    "#models/*": "./src/*"
  },
  "scripts": {
    "refresh": "tsx ./scripts/models.ts",
    "test": "tsx --test \"./src/**/*.test.ts\" \"./scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opendum/extension": "workspace:*",
    "fuzzball": "^2.2.6",
    "p-retry": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
