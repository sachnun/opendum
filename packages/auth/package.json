{
  "name": "@opendum/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./types": "./src/types.ts",
    "./custom-store": "./src/custom-store.ts"
  },
  "scripts": {
    "test": "tsx --test ./src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opendum/crypto": "workspace:*",
    "@opendum/database": "workspace:*",
    "@opendum/models": "workspace:*",
    "@opendum/redis": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "imports": {
    "#auth/*": "./src/*"
  }
}
